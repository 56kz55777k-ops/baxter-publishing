# Baxter Publishing — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─────────────────────────────────────────────────────────────
# Supabase
# Project URL + publishable key are public (safe to ship in browsers).
# Service-role key and DATABASE_URL are server-only — never expose.
# Get them at: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (object storage)
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=baxter-quarantine
R2_BUCKET_ORIGINALS=baxter-originals
R2_BUCKET_ARTIFACTS=baxter-artifacts
R2_PUBLIC_URL=

# ─────────────────────────────────────────────────────────────
# Cloudflare Images (public image delivery)
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Stripe Connect (marketplace payments)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PLATFORM_FEE_BPS=1000   # 10% platform fee, basis points

# ─────────────────────────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=editorial@baxterpublishing.com
ADMIN_NOTIFICATION_EMAIL=benjamin@benjamingibson.ca

# ─────────────────────────────────────────────────────────────
# Inngest (workflow engine)
# ─────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
