# Baxter Publishing — environment template
#
# Copy to .env.local and fill in real values. Never commit .env.local.
# EVERY VALUE HERE STAYS EMPTY. This file is committed to a public
# repository; a real value in it is an incident, not a typo. The only
# populated entries are non-secret illustrative defaults, marked as such.
#
# Deployed values live in Vercel as environment variables of type Secret
# (write-only after saving). See docs/security-operations.md.
#
# Names below are the ones the code actually reads. If you add a variable,
# add it here too — a template that has drifted from the code is how people
# end up setting the wrong name and debugging a silent fallback.

# ─────────────────────────────────────────────────────────────
# Supabase
# Project URL + publishable key are public (safe to ship in browsers).
# The service-role key BYPASSES Row Level Security: server-side only,
# never on a developer machine, never in CI, never in a client bundle.
# Get them at: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string. Read only by packages/db (Drizzle
# schema + migration tooling); no application code path imports it today.
# Needed for migrations, not for running the app.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (object storage)
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket names are not secrets. The values shown are the fallbacks in
# lib/r2/client.ts, which apply when the variable is unset — they are not
# necessarily what production uses. "Quarantine" here means unverified by
# preflight; there is no antivirus in this pipeline.
R2_BUCKET_QUARANTINE=baxter-quarantine
R2_BUCKET_ARTIFACTS=baxter-clean

# ─────────────────────────────────────────────────────────────
# Cloudflare Images (public image delivery)
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# Stripe Connect (marketplace payments)
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PLATFORM_FEE_BPS=1000             # 10% platform fee, basis points

# ─────────────────────────────────────────────────────────────
# Resend (transactional email)
# The key needs Sending access only — Baxter calls POST /emails and
# nothing else. Full access is more authority than the code can use.
# RESEND_FROM_ADDRESS must be on a domain verified in the Resend account,
# or every send fails.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
ADMIN_NOTIFICATION_EMAIL=

# ─────────────────────────────────────────────────────────────
# Inngest (workflow engine)
# ─────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # default, not a secret
NATIVE_PUBLISHING=                            # '1' enables the editor route

# ─────────────────────────────────────────────────────────────
# End-to-end tests — NOT read from this file.
# Playwright reads apps/web/.env.e2e.local (gitignored), which supplies
# E2E_EMAIL, E2E_PASSWORD and E2E_PUBLICATION_ID. The smoke skips with a
# clear message when they are absent; it never fabricates a session.
# Those are real account credentials: keep them in a password manager and
# out of this repository. See docs/security-operations.md § 8.
# ─────────────────────────────────────────────────────────────
