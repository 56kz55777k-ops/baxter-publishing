{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.mts",
    "lib/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "test/preflight.verify.ts"
  ]
}
